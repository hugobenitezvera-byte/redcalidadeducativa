# Copiar a n8n/.env y completar. NUNCA commitear el .env (el repositorio es público).

# --- n8n ---
# Clave que cifra las credenciales guardadas en n8n. Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# URL pública HTTPS por la que Meta llegará a n8n (con barra final).
# Ej.: https://n8n.tu-dominio.edu.py/  o la URL de un túnel de prueba.
WEBHOOK_URL=

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API) ---
# Phone number ID (NO es el número de teléfono). Se ve en "Configuración de la API".
WHATSAPP_PHONE_NUMBER_ID=
# App Secret: App settings > Basic > App secret. Se usa para validar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Texto libre que inventás vos; el mismo se carga en Meta al configurar el webhook.
# Generar con: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=
# Versión de Graph API: usar la que muestra el panel de tu app (ej. v23.0).
WHATSAPP_GRAPH_VERSION=
# Solo para pruebas locales con scripts/mock_graph_api.py. En uso real dejar vacío.
WHATSAPP_GRAPH_BASE_URL=

# --- Seguridad de la prueba ---
# Números (wa_id, solo dígitos, con código de país) a los que el flujo de prueba
# SÍ responde, separados por coma. Cualquier otro número se ignora.
WA_TEST_ALLOWED_NUMBERS=

# El ACCESS TOKEN de WhatsApp NO va aquí: se carga como credencial cifrada en n8n
# (tipo "Header Auth", nombre "WhatsApp Cloud API token").
